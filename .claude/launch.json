{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@paperseal/web",
        "dev"
      ],
      "port": 5171
    },
    {
      "name": "verifier",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@paperseal/verifier",
        "dev"
      ],
      "port": 5172
    },
    {
      "name": "ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@paperseal/ui",
        "preview"
      ],
      "port": 5179
    },
    {
      "name": "presentation",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "presentation"
      ],
      "port": 5180
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "demo:keys"
      ],
      "port": 5171
    }
  ]
}