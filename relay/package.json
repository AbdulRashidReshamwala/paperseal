{
  "name": "@paperseal/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mirrors an exam's public unlock evidence (release log and release token), a registry's exam index and Swarm backups of an exam's storage files to Arkiv, as in spec/arkiv.md \"Writers\", \"Exam Index\" and \"Backups\".",
  "scripts": {
    "mirror": "node cli.mjs mirror",
    "watch": "node cli.mjs watch",
    "status": "node cli.mjs status",
    "index": "node cli.mjs index",
    "backup": "node cli.mjs backup",
    "swarm-status": "node cli.mjs swarm-status",
    "dry-check": "node cli.mjs dry-check",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paperseal/arkiv": "workspace:*",
    "@paperseal/chain": "workspace:*",
    "@paperseal/protocol": "workspace:*",
    "@paperseal/swarm": "workspace:*",
    "@paperseal/tee-client": "workspace:*",
    "viem": "2.57.16",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
