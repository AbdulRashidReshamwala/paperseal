{
  "name": "paperseal",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "abi:sync": "make abi",
    "demo": "pnpm --filter @paperseal/e2e demo",
    "demo:check": "pnpm --filter @paperseal/e2e demo:check",
    "demo:keys": "pnpm --filter @paperseal/web demo:keys",
    "demo:vm": "node e2e/demo/cli.mjs vm"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
