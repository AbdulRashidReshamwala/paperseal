# /etc/paperseal-relay.env, read by the paperseal-relay-* units. No secrets: the
# keystore and its password file live in the relay user's home.
REGISTRY=0xc25F7e0004f0E9B77581CFf6B4B5Ae8b120658eb
# The block ExamRegistry was deployed in, so the index sees every exam.
INDEX_FROM_BLOCK=12077499
STORAGE_URL=https://storage.googleapis.com/paperseal-demo-paperseal-exams
TEE_URL=https://tee.abdulrashid.dev
# The postage batch backups are stamped with, on the Bee node on this VM.
SWARM_BATCH=9ffbf39decf0958ad5119a396e286f62b813318e964983c5f5e052c54b0a19c4
SWARM_API=http://127.0.0.1:1633
